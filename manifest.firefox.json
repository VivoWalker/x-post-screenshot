{
  "manifest_version": 3,
  "name": "X 帖子截图",
  "version": "0.5.0",
  "description": "用快捷键截取 X/Twitter 帖子，并将完整 PNG 复制到剪贴板。",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "scripting"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "background": {
    "scripts": ["png-stitch.js", "firefox-background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "start-capture": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "选择并截图 X 帖子"
    }
  },
  "action": {
    "default_title": "选择并截图 X 帖子"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "x-post-screenshot@vivowalker.github.io",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
